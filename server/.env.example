# ============================================================
# NAMIRA MEDICAL PLATFORM
# SERVER ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

NODE_ENV=development

APP_NAME=Namira Medical Platform

APP_VERSION=1.0.0

PORT=5000

API_PREFIX=/api/v1

SERVER_URL=http://localhost:5000

CLIENT_WEB_URL=http://localhost:3000

CLIENT_MOBILE_SCHEME=namiramedical://

# BET-23 — upper bound (ms) the graceful-shutdown handler waits for
# in-flight requests + Redis/Mongo disconnects before forcing exit.
SHUTDOWN_TIMEOUT_MS=10000


# ------------------------------------------------------------
# MONGODB
# ------------------------------------------------------------

MONGODB_URI=

MONGODB_DB_NAME=Ash-Shāfī

# DNS servers requested for MongoDB DNS resolution.
# The application will configure these programmatically.
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=8.8.8.8

# BET-23 — startup connection retry (recovery from transient
# network/DNS blips at boot) and the timeout for GET /health/ready's
# live database ping.
DB_CONNECT_RETRY_ATTEMPTS=5
DB_CONNECT_RETRY_DELAY_MS=2000
DB_HEALTH_PING_TIMEOUT_MS=3000


# ------------------------------------------------------------
# JWT / AUTHENTICATION
# ------------------------------------------------------------

# BET-23 — in production, both secrets must be >= 32 chars, must not
# match each other, and must not look like a placeholder (the app
# refuses to boot in production otherwise). Generate with e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_EXPIRES_IN=30d

JWT_ISSUER=namira-medical-platform

JWT_AUDIENCE=namira-medical-platform-users


# ------------------------------------------------------------
# PASSWORD SECURITY
# ------------------------------------------------------------

ARGON2_MEMORY_COST=65536

ARGON2_TIME_COST=3

ARGON2_PARALLELISM=4


# ------------------------------------------------------------
# COOKIE SECURITY
# ------------------------------------------------------------

COOKIE_DOMAIN=

COOKIE_SECURE=false

COOKIE_SAME_SITE=lax


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173


# ------------------------------------------------------------
# CLOUDINARY
# ------------------------------------------------------------

CLOUDINARY_URL=


# ------------------------------------------------------------
# ELEVENLABS VOICE AGENT (optional)
# Leave blank to keep voice features inert. See
# docs/elevenlabs-voice-agent.md for full setup.
# ------------------------------------------------------------

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=


# ------------------------------------------------------------
# FILE UPLOAD LIMITS
# ------------------------------------------------------------

MAX_PROFILE_IMAGE_SIZE_MB=2

MAX_DOCUMENT_SIZE_MB=25

MAX_PDF_SIZE_MB=25

MAX_IMAGE_SIZE_MB=10

MAX_VIDEO_SIZE_MB=250

MAX_AUDIO_SIZE_MB=25


# ------------------------------------------------------------
# OCR / MEDICAL DOCUMENT EXTRACTION (BET-12)
# All defaults target the tesseract/pdftoppm CLI binaries. Only
# 'tesseract' is a supported OCR_PROVIDER value right now — the
# extraction pipeline is provider-abstracted (see
# modules/reports/services/ocr.service.js) so a future cloud OCR
# vendor can be added without changing anything outside that file.
# ------------------------------------------------------------

OCR_PROVIDER=tesseract

OCR_DEFAULT_LANGUAGES=eng

OCR_TESSERACT_BIN=tesseract

OCR_PDFTOPPM_BIN=pdftoppm

OCR_TIMEOUT_MS=60000


# ------------------------------------------------------------
# EMAIL
# ------------------------------------------------------------

SMTP_HOST=

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=

SMTP_PASSWORD=

SMTP_FROM_NAME=Ash-Shāfī

SMTP_FROM_EMAIL=


# ------------------------------------------------------------
# SMS
# ------------------------------------------------------------

SMS_PROVIDER=

SMS_API_URL=

SMS_API_KEY=

SMS_API_SECRET=

SMS_SENDER_ID=


# ------------------------------------------------------------
# WHATSAPP
# ------------------------------------------------------------

WHATSAPP_PROVIDER=

WHATSAPP_API_URL=

WHATSAPP_ACCESS_TOKEN=

WHATSAPP_PHONE_NUMBER_ID=

WHATSAPP_BUSINESS_ACCOUNT_ID=

# BET-16 Checkpoint 4 — inbound webhook verification (optional; the
# webhook receiver stays disabled/fails closed until both are set).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

WHATSAPP_APP_SECRET=


# ------------------------------------------------------------
# GOOGLE
# ------------------------------------------------------------

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/integrations/google/callback


# ------------------------------------------------------------
# GOOGLE DRIVE BACKUP
# ------------------------------------------------------------

GOOGLE_DRIVE_CLIENT_ID=

GOOGLE_DRIVE_CLIENT_SECRET=

GOOGLE_DRIVE_REDIRECT_URI=

GOOGLE_DRIVE_REFRESH_TOKEN=

GOOGLE_DRIVE_BACKUP_FOLDER_ID=


# ------------------------------------------------------------
# PAYMENT GATEWAY
# ------------------------------------------------------------

PAYMENT_PROVIDER=

PAYMENT_API_URL=

PAYMENT_API_KEY=

PAYMENT_API_SECRET=

PAYMENT_WEBHOOK_SECRET=

PAYMENT_CURRENCY=BDT


# ------------------------------------------------------------
# EMAIL VERIFICATION
# ------------------------------------------------------------

EMAIL_VERIFICATION_EXPIRES_MINUTES=30


# ------------------------------------------------------------
# PASSWORD RESET
# ------------------------------------------------------------

PASSWORD_RESET_EXPIRES_MINUTES=15


# ------------------------------------------------------------
# ACCOUNT SECURITY
# ------------------------------------------------------------

MAX_LOGIN_ATTEMPTS=5

LOGIN_LOCKOUT_MINUTES=15

MAX_PASSWORD_RESET_ATTEMPTS=5

MAX_OTP_ATTEMPTS=5


# ------------------------------------------------------------
# OTP
# ------------------------------------------------------------

OTP_EXPIRES_MINUTES=5

OTP_LENGTH=6


# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------

RATE_LIMIT_WINDOW_MS=900000

RATE_LIMIT_MAX_REQUESTS=300

AUTH_RATE_LIMIT_MAX_REQUESTS=10

PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=5


# ------------------------------------------------------------
# SOCKET.IO
# ------------------------------------------------------------

SOCKET_PATH=/socket.io

SOCKET_CORS_ORIGINS=http://localhost:3000


# ------------------------------------------------------------
# MESSAGING (BET-13)
# ------------------------------------------------------------

MESSAGING_ATTACHMENT_DOWNLOAD_URL_EXPIRES_SECONDS=120

MAX_MESSAGE_ATTACHMENT_SIZE_MB=15

MAX_VOICE_MESSAGE_SIZE_MB=10

MAX_VOICE_MESSAGE_DURATION_SECONDS=300


# ------------------------------------------------------------
# REDIS
# ------------------------------------------------------------

REDIS_ENABLED=false

REDIS_URL=


# ------------------------------------------------------------
# ENCRYPTION
# ------------------------------------------------------------

# BET-23 — same production requirements as the JWT secrets above:
# >= 32 chars, must differ from each other, must not look like a
# placeholder value.
DATA_ENCRYPTION_KEY=

FIELD_ENCRYPTION_KEY=


# ------------------------------------------------------------
# BACKUP
# ------------------------------------------------------------

BACKUP_ENABLED=true

BACKUP_SCHEDULE=0 2 * * *

BACKUP_RETENTION_DAYS=30

BACKUP_ENCRYPTION_ENABLED=true


# ------------------------------------------------------------
# AUDIT LOGGING
# ------------------------------------------------------------

AUDIT_LOG_ENABLED=true

AUDIT_LOG_RETENTION_DAYS=2555


# ------------------------------------------------------------
# DATA LIFECYCLE / RETENTION (BET-17 Checkpoint 4)
# ------------------------------------------------------------

NOTIFICATION_RETENTION_DAYS=180


# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------

LOG_LEVEL=info

LOG_PRETTY=true


# ------------------------------------------------------------
# MEDICAL RECORD SETTINGS
# ------------------------------------------------------------

MEDICAL_RECORD_EXPORT_ENABLED=true

PATIENT_DATA_EXPORT_ENABLED=true

PATIENT_ACCOUNT_SOFT_DELETE=true


# ------------------------------------------------------------
# FHIR
# ------------------------------------------------------------

FHIR_ENABLED=true

FHIR_VERSION=R4

FHIR_BASE_URL=/api/v1/fhir


# ------------------------------------------------------------
# TELEMEDICINE
# ------------------------------------------------------------

TELEMEDICINE_ENABLED=true

VIDEO_CALL_PROVIDER=

VIDEO_CALL_API_URL=

VIDEO_CALL_API_KEY=

VIDEO_CALL_API_SECRET=


# ------------------------------------------------------------
# VIDEO CONSULTATION (BET-14)
# ------------------------------------------------------------
# Selects the active VideoProvider implementation. 'native' (default)
# is peer-to-peer WebRTC signaled over the existing Socket.IO
# connection — media never touches this server or any third party.

VIDEO_PROVIDER=native

# STUN/TURN servers handed to the browser's RTCPeerConnection, as a
# JSON array. STUN-only by default (never relays call media).

VIDEO_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Minutes before scheduledStart a participant may join.

VIDEO_EARLY_JOIN_MINUTES=10

# Minutes after scheduledStart before an unjoined session expires.

VIDEO_WAITING_ROOM_TIMEOUT_MINUTES=30

# Informational cap only (not enforced as a hard cutoff).

VIDEO_MAX_SESSION_DURATION_MINUTES=60

# TTL for the single-use join credential issued on POST
# /video-calls/sessions/:id/join.

VIDEO_JOIN_TOKEN_TTL_MINUTES=10


# ------------------------------------------------------------
# APPLICATION OWNER
# ------------------------------------------------------------

OWNER_NAME=Fahim Khan

OWNER_EMAIL=

OWNER_USERNAME=

OWNER_INITIAL_ROLE=SUPER_ADMIN


# ------------------------------------------------------------
# MAIN DOCTOR
# ------------------------------------------------------------

DIRECTOR_NAME=Ash-Shāfī

DIRECTOR_EMAIL=

DIRECTOR_USERNAME=

DIRECTOR_INITIAL_ROLE=DIRECTOR


# ------------------------------------------------------------
# INITIAL SYSTEM ADMIN
# ------------------------------------------------------------

INITIAL_ADMIN_PASSWORD=


# ------------------------------------------------------------
# INITIAL OWNER PASSWORD
# ------------------------------------------------------------

OWNER_INITIAL_PASSWORD=


# ------------------------------------------------------------
# INITIAL DIRECTOR PASSWORD
# ------------------------------------------------------------

DIRECTOR_INITIAL_PASSWORD=


# ------------------------------------------------------------
# SYSTEM
# ------------------------------------------------------------

SYSTEM_TIMEZONE=Asia/Dhaka

DEFAULT_LANGUAGE=en

SUPPORTED_LANGUAGES=en,bn,hi,ur

DEFAULT_CURRENCY=BDT


# ------------------------------------------------------------
# DEVELOPMENT
# ------------------------------------------------------------

DEBUG=false

ENABLE_API_DOCS=true

ENABLE_DEV_ROUTES=false